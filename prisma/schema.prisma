datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

/* ─────────────────────────────
   ENUMS
────────────────────────────── */
enum Role {
  ADMIN
  STUDENT
  TEACHER
}

enum Gender {
  MALE
  FEMALE
  OTHER
  NOT_MENTIONED
}

enum NeuroProblemType {
  ADHD
  AUTISM
  DYSLEXIA
  DYSPRAXIA
  OCD
  TOURETTE_SYNDROME
  ANXIETY_DISORDER
  DEPRESSION
  BIPOLAR_DISORDER
  NOT_MENTIONED
}

enum Education {
  CLASS_1
  CLASS_2
  CLASS_3
  CLASS_4
  CLASS_5
  CLASS_6
  CLASS_7
  CLASS_8
  CLASS_9
  CLASS_10
  CLASS_11
  CLASS_12
  NOT_MENTIONED
}

enum Affiliation {
  WBBSE
  WBCHSE
  CBSE
  NOT_MENTIONED
}

enum Qualification {
  B_TECH
  B_A
  B_SC
  B_COM
  M_TECH
  M_A
  M_SC
  M_COM
  M_PHIL
  PHD
  NOT_MENTIONED
}

enum EvaluationMode {
  MANUAL
  AUTO
}

enum BehaviorType {
  PAGE_FOCUS
  CLICK
  IDLE
}

/* ─────────────────────────────
   USER MODEL
────────────────────────────── */
model User {
  id               String    @id @default(uuid())  
  firstName        String
  middleName       String?   @default("")
  lastName         String
  dob              DateTime?
  email            String    @unique
  password         String
  homeTown         String?   @default("Not mentioned yet.")
  currentCity      String?   @default("Not mentioned yet.")
  gender           Gender    @default(NOT_MENTIONED)
  role             Role      @default(STUDENT)
  isActive         Boolean   @default(true)
  createdBy        String?   @default("")
  updatedBy        String?   @default("")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?
  profilePhoto     String?   @default("")

  // Relations
  studentProfile   StudentProfile?
  teacherProfile   TeacherProfile?
  preferences      Json?     @default("{}")
  cognitive        CognitiveProfile?
  emotionLogs      EmotionLog[]
  feedbacks        Feedback[]
  mindmaps         Mindmap[]
  adaptations      AdaptationLog[]
  groups Group[] @relation("TeacherGroups")
  groupMemberships GroupMember[] @relation("UserGroupMemberships")
  assignmentsGiven Assignment[]           @relation("TeacherAssignments")
  assignmentsReceived AssignmentStudent[] @relation("StudentAssignments")
  assignmentSubmissions AssignmentSubmission[] @relation("StudentSubmissions")
  reviewedMindmaps Mindmap[] @relation("ReviewedMindmaps")
  studentInvites StudentInvite[] @relation("TeacherInvites")
  teacherFeedbacksGiven   TeacherFeedback[]        @relation("TeacherToFeedbacks")
  teacherFeedbacksReceived TeacherFeedback[]       @relation("TeacherFeedbackStudent")
  teacherNotifications Notification[] @relation("UserTeacherNotifications")
  studentNotifications Notification[] @relation("UserStudentNotifications")
  sentMails      MailLog[] @relation("UserSentMails")
  receivedMails  MailLog[] @relation("UserReceivedMails")
  teacherStudents TeacherStudent[] @relation("TeacherToStudents")
  studentTeachers TeacherStudent[] @relation("StudentToTeachers")
  activityLogs ActivityLog[]
  behaviorEvents BehaviorEvent[]
}

/* ─────────────────────────────
   STUDENT PROFILE
────────────────────────────── */
model StudentProfile {
  id               String           @id @default(uuid())  
  userId           String           @unique  
  user             User             @relation(fields: [userId], references: [id])
  neuroProblemType NeuroProblemType @default(NOT_MENTIONED)
  education        Education        @default(NOT_MENTIONED)
  affiliation      Affiliation      @default(NOT_MENTIONED)
  instituteName    String?          @default("Not mentioned yet.")
  guardianName     String?          @default("Not mentioned yet.")
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}

/* ─────────────────────────────
   TEACHER PROFILE
────────────────────────────── */
model TeacherProfile {
  id               String         @id @default(uuid())  
  userId           String         @unique  
  user             User           @relation(fields: [userId], references: [id])
  qualification    Qualification  @default(NOT_MENTIONED)
  experience       Int?
  specialization   String?        @default("Not mentioned yet.")
  instituteName    String?        @default("Not mentioned yet.")
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

/* ─────────────────────────────
   MINDMAP MODEL
────────────────────────────── */
model Mindmap {
  id           String   @id @default(uuid())
  title        String
  description  String?  @default("No description provided.")
  structure    Json
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  reviewedById String?
  reviewedBy   User?    @relation("ReviewedMindmaps", fields: [reviewedById], references: [id])
  approval     Boolean  @default(false)
  comments     String?  @default("No comments added.")
}

/* ─────────────────────────────
   Cognitive Profile
────────────────────────────── */
model CognitiveProfile {
  id             String   @id @default(uuid())
  userId         String   @unique
  attentionScore Float?
  focusDuration  Int?
  interactions   Int?
  lastUpdated    DateTime @updatedAt
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id])
}

/*─────────────────────────────
 Behavior Event LOG
──────────────────────────────*/
model BehaviorEvent {
  id        String   @id @default(uuid())
  userId    String
  type      BehaviorType
  metadata  Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([type])
  @@index([createdAt])
}

/* ─────────────────────────────
   Emotion Log
────────────────────────────── */
model EmotionLog {
  id        String   @id @default(uuid())
  userId    String
  emotion   String
  intensity Float?
  meta      Json?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

/* ─────────────────────────────
   Feedback
────────────────────────────── */
model Feedback {
  id        String   @id @default(uuid())
  userId    String
  mapId     String?
  rating    Int?
  comments  String?
  timeSpent Int?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

/* ─────────────────────────────
   Adaptation Log
────────────────────────────── */
model AdaptationLog {
  id        String   @id @default(uuid())
  userId    String
  changes   Json
  reason    String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

/* ─────────────────────────────
   ASSIGNMENT MODELS
────────────────────────────── */
model Assignment {
  id            String              @id @default(uuid())
  title         String
  description   String?
  teacherId     String
  createdAt     DateTime            @default(now())
  assignedTo    AssignmentStudent[]
  submissions   AssignmentSubmission[] @relation("AssignmentToSubmissions")
  teacher       User                @relation("TeacherAssignments", fields: [teacherId], references: [id])
  assignmentGroups AssignmentGroup[]  @relation("AssignmentGroupRelation")
  evaluationMode  EvaluationMode         @default(AUTO) // or "MANUAL"
  metadata        Json?                  @default("{}")
}

model AssignmentStudent {
  id           String   @id @default(uuid())
  assignmentId String
  studentId    String
  status       String   @default("PENDING")
  assignment   Assignment @relation(fields: [assignmentId], references: [id])
  student      User       @relation("StudentAssignments", fields: [studentId], references: [id])
}

model AssignmentSubmission {
  id             String   @id @default(uuid())
  assignmentId   String
  studentId      String
  content        String
  status         String   @default("SUBMITTED")
  grade          Float?
  feedback       String?
  sentiment      String?
  sentimentScore Float?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  assignment     Assignment @relation("AssignmentToSubmissions", fields: [assignmentId], references: [id])
  student        User       @relation("StudentSubmissions", fields: [studentId], references: [id])
}

/* ─────────────────────────────
  GROUP MODELS
────────────────────────────── */
model Group {
  id          String        @id @default(uuid())
  name        String
  description String?       @default("")
  teacherId   String
  teacher     User          @relation("TeacherGroups", fields: [teacherId], references: [id])
  members     GroupMember[] @relation("GroupMembersRelation")
  assignments AssignmentGroup[] 
  invites     StudentInvite[] @relation("GroupInvites")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model GroupMember {
  id        String   @id @default(uuid())
  groupId   String
  userId    String
  group     Group    @relation("GroupMembersRelation", fields: [groupId], references: [id])
  user      User     @relation("UserGroupMemberships", fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@unique([groupId, userId], name: "compositeId")
}

model AssignmentGroup {
  id           String      @id @default(uuid())
  assignmentId String
  groupId      String
  assignment   Assignment  @relation("AssignmentGroupRelation", fields: [assignmentId], references: [id])
  group        Group       @relation( fields: [groupId], references: [id])
}

/* ─────────────────────────────
  STUDENT INVITE MODELS
────────────────────────────── */
model StudentInvite {
  id         String   @id @default(cuid())
  email      String   @unique
  token      String
  teacherId  String
  groupId    String?
  used       Boolean  @default(false)
  expiresAt  DateTime

  teacher    User     @relation("TeacherInvites", fields: [teacherId], references: [id])
  group      Group?   @relation("GroupInvites", fields: [groupId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now())
}

/* ─────────────────────────────
  Notification System
────────────────────────────── */
model Notification {
  id          String   @id @default(uuid())
  title       String
  message     String
  type        String   @default("Info")
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  // Relations
  teacherId   String?
  studentId   String?
  teacher     User?    @relation("UserTeacherNotifications", fields: [teacherId], references: [id])
  student     User?    @relation("UserStudentNotifications", fields: [studentId], references: [id])
}

/* ─────────────────────────────
| Teacher Feedback (manual)
────────────────────────────── */
model TeacherFeedback {
  id          String   @id @default(uuid())
  teacherId   String
  studentId   String
  feedback    String
  createdAt   DateTime @default(now())

  teacher     User     @relation("TeacherToFeedbacks", fields: [teacherId], references: [id])
  student     User     @relation("TeacherFeedbackStudent", fields: [studentId], references: [id])
}

model MailLog {
  id           String   @id @default(uuid())  
  senderId     String?   
  recipientId  String?   
  to           String
  subject      String
  body         String?
  status       String   @default("SENT")
  error        String?
  sentAt       DateTime @default(now())
  createdAt    DateTime @default(now())

  sender       User? @relation("UserSentMails", fields: [senderId], references: [id])
  recipient    User? @relation("UserReceivedMails", fields: [recipientId], references: [id])
}

model TeacherStudent {
  id         String   @id @default(uuid())
  teacherId  String
  studentId  String
  createdAt  DateTime @default(now())

  teacher    User     @relation("TeacherToStudents", fields: [teacherId], references: [id])
  student    User     @relation("StudentToTeachers", fields: [studentId], references: [id])

  @@unique([teacherId, studentId], name: "UniqueTeacherStudent")
}

/*─────────────────────────────
 ADMIN ACTIVITY LOG
──────────────────────────────*/
model ActivityLog {
  id        String   @id @default(uuid())
  userId    String?  @default("System")
  action    String
  details   String?
  createdAt DateTime @default(now())

  user      User?     @relation(fields: [userId], references: [id])
}